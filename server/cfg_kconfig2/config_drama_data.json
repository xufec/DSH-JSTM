", 1, 44, 27], [null, 0, 1.5, "E60429", 1, 40, 29], [null, 0, 1.5, "E60429", 1, 41, 27], [null, 0, 1, 2, 10969, "我们将一起面对人生的一切，去分享我们的梦想，作为平等的忠实伴侣，度过今后的一生"], [null, 0, 2, 1, 50002, "我们将一起面对人生的一切，去分享我们的梦想，作为平等的忠实伴侣，度过今后的一生"], [null, 0, 1.5, "E60429", 1, 39, 26], [null, 0, 2, 2, 10969, "我将努力去理解你，完全的信任你，我们将成为一个整体，互为彼此的一部分"], [null, 0, 2, 1, 50002, "我将努力去理解你，完全的信任你，我们将成为一个整体，互为彼此的一部分"], [null, 0, 1.5, "E60429", 1, 39, 26], [null, 0, 2.5, 2, 10969, "我全心全意认你做我的伴侣，无论顺境或逆境，富裕或贫穷，健康或疾病，快乐或忧愁，我都将毫无保留的爱你！"], [null, 0, 2.5, 1, 50002, "小姐请跟我重复：我全心全意认你做我的伴侣，无论顺境或逆境，富裕或贫穷，健康或疾病，快乐或忧愁，我都将毫无保留的爱你！"], [null, 0, 1.5, "E60429", 1, 39, 26], [null, 0, 2, 2, 10968, "我们将一起面对人生的一切，去分享我们的梦想，作为平等的忠实伴侣，度过今后的一生"], [null, 0, 2, 1, 50002, "我们将一起面对人生的一切，去分享我们的梦想，作为平等的忠实伴侣，度过今后的一生"], [null, 0, 2, 2, 10968, "我将努力去理解你，完全的信任你，我们将成为一个整体，互为彼此的一部分"], [null, 0, 2, 1, 50002, "我将努力去理解你，完全的信任你，我们将成为一个整体，互为彼此的一部分"], [null, 0, 1.5, "E60429", 1, 39, 26], [null, 0, 2.5, 2, 10968, "我全心全意认你做我的伴侣，无论顺境或逆境，富裕或贫穷，健康或疾病，快乐或忧愁，我都将毫无保留的爱你！"], [null, 0, 2.5, 1, 50002, "先生请跟我说：我全心全意认你做我的伴侣，无论顺境或逆境，富裕或贫穷，健康或疾病，快乐或忧愁，我都将毫无保留的爱你！"], [null, 0.1, 0.5, 2, 10969, 41, 26, 2], [null, 0.1, 0.5, 2, 10968, 40, 27, 6], [null, 0, 0.1, 2, 10970], [null, 0, 1.5, "E60429", 1, 44, 27], [null, 0, 1.5, "E60429", 1, 40, 29], [null, 0, 1.5, "E60429", 1, 41, 27], [null, 0, 1, 2, 10970, "turn", 0], [null, 0, 2.5, 1, 50002, "现在请你们面向对方，深情的望着对方，庄严的向对方宣告誓言！"], [null, 0, 2, 2, 10970, "嗯呐，我愿意！<img src='E61514'/>"], [null, 0, 3.5, 1, 50002, "美丽的小姐，今天你以情缘的形式接受了这位先生作为你的合法伴侣，从今以后，无论健康疾病，无论富贵贫穷，你愿意爱她尊敬她保护她并与她相伴终生吗？！"], [null, 0, 2, 2, 10970, "是的，我愿意！<img src='E61514'/>"], [null, 1, 3.5, 1, 50002, "英俊的先生，今天你以情缘的形式接受了这位小姐作为你的合法伴侣，从今以后，无论健康疾病，无论富贵贫穷，你愿意爱她尊敬她保护她并与她相伴终生吗？"], [null, 0, 3, "E60429", 1, 38, 25], [null, 0, 3, "E60429", 1, 38, 29], [null, 0, 3, "E60429", 1, 43, 25], [null, 0, 3, "E60429", 1, 45, 26], [null, 0, 3, "E60429", 1, 41, 30], [null, 0, 3, "E60429", 1, 42, 28], [null, 0, 3, 1, 50002, "英俊的男主人公和漂亮的女主人公牵手走到了一起，整个教堂洋溢着幸福气息，兄弟姐妹们，亲朋好友们，让我们用热烈的掌声，对他们的幸福结合表示祝福！"], [null, 0, 3, 1, 50002, "各位来宾，各位朋友，两情相悦，地久天长，伴随着庄严的仪式进行曲，今天世界上最幸福的一对新人，将结成情缘"], [null, 1, 5, 2, 10970, "感谢各位亲朋好友前来参加我们的情缘仪式！<img src='E61501'/>"], [null, 0, 3, 2, 10970, "哇哦，好美啊！感觉好幸福~<img src='E61515'/>"], [null, 0, 5.4, "E60429", 1, 38, 28], [null, 0, 5.4, "E60429", 1, 34, 26], [null, 0, 5.4, "E60429", 1, 30, 24], [null, 0, 5.4, "E60429", 1, 26, 22], [null, 0, 5.4, "E60429", 1, 22, 20], [null, 0, 5.4, "E60429", 1, 18, 18], [null, 0, 5.4, "E60429", 1, 41, 24], [null, 0, 5.4, "E60429", 1, 37, 22], [null, 0, 5.4, "E60429", 1, 33, 20], [null, 0, 5.4, "E60429", 1, 29, 18], [null, 0, 5.4, "E60429", 1, 25, 16], [null, 0, 5.4, "E60429", 1, 21, 14], [null, 0, 1, 2, 10970, "<img src='E61517'/> 我们情缘有成啦！"], [null, 1, 5.4, "E60429", 1, 38, 28], [null, 1, 5.4, "E60429", 1, 34, 26], [null, 1, 5.4, "E60429", 1, 30, 24], [null, 1, 5.4, "E60429", 1, 26, 22], [null, 1, 5.4, "E60429", 1, 22, 20], [null, 1, 5.4, "E60429", 1, 18, 18], [null, 1, 5.4, "E60429", 1, 41, 24], [null, 1, 5.4, "E60429", 1, 37, 22], [null, 1, 5.4, "E60429", 1, 33, 20], [null, 1, 5.4, "E60429", 1, 29, 18], [null, 1, 5.4, "E60429", 1, 25, 16], [null, 1, 5.4, "E60429", 1, 21, 14], [null, 0, 4, 43, 29, 1], [null, 0, 1, 2, 10970, 41, 27], [null, 0, 2, 18, 15, 15], [null, 1, 0.1, 2, 10970, 18, 15, 8], [null, 1, 2, 1, 50002, "明媚的阳光，神圣的教徒，欢声笑语，天降吉祥。我宣布，情缘仪式现在开始！有请两位新人携手走进仪式的殿堂！"], [null, 0, 90, "s_008", 1], [null, 0, 1, 43, 29, 80], [null, 0, 0], [null, 0, 1, 1, 50002, 45, 30, 4], [null, 0, 1, 3], [null, 0, 2, 2, 44009, "这难道就是极致之冰的威力吗？"], [null, 2], [null, 0, 2, 2, 40065, "凌落宸什么时候能放出这么强大的冰系法术了？"], [null, 1], [null, 0, 2, 2, 44009, "这种极致之冰的感受……太美妙了！"], [null, 0, 0.5, 44009, 1, 4], [null, 0], [null, 0, 0, 20021], [null, 0.6, 1, 5], [null, 0, 0], [null, 0, 10, 1, 20220, "小桃你别神气，我看出来这几个新生实力可不简单，我们再来一次！"], [null, 0, 10, 1, 10010, "钥衡，你与小桃交换，其他人保持不变，你们再对抗一次！"], [null, 0, 10, 1, 10010, "嘿嘿，小桃，你以为你们获胜主要原因在于你的实力压制吗？"], [null, 0, 10, 1, 20210, "戴钥衡，你不是总不服气我是队长吗？今天这场输得服气不服气？"], [null, 0, 1, 0], [null, 0, 0], [null, 0, 2, 2, 40062, "我的冰法术为什么一点作用都没有？"], [null, 2], [null, 0, 2, 2, 40060, "小桃的流星雨怎么砸得这么准？"], [null, 1], [null, 0, 2, 2, 44008, "给我精神共享，我来让他们尝尝邪火的威力"], [null, 0, 0.5, 44008, 1, 4], [null, 0], [null, 0, 0, 20020], [null, 0.6, 1, 5], [null, 0, 0], [null, 0, 10, 1, 20210, "好的，多亏你的极致之冰压制了我的邪火之力，今天我要痛痛快快一战！"], [null, 0, 10, 1, 10010, "今天你们新老两代史莱克七怪齐聚，为了方便你们互相了解，你们打乱组队对抗！"], [null, 0, 1, 0], [null, 0, 0], [null, 0, 2, "没想到七宝琉璃宗居然出了四窍玲珑心的天才"], [null, 0, 2, 2, 40051, "七宝有名，力、敏、速、血"], [null, 1], [null, 0, 2, "当然是我们最强了！"], [null, 0, 2, 2, 40050, "嘿嘿，看看我们谁才是外院最强阵容吧！"], [null, 0], [null, 0, 2, "看来只能打败火灵才可以让小桃姐清醒了！"], [null, 2], [null, 0, 2, 2, 40045, "焚……尽……一……切……"], [null, 0, 0, 40045, "H34410"], [null, 1], [null, 0, 2, "小桃姐！你要撑住啊！"], [null, 0, 2, 2, 40045, "我……快控制不住自己了！"], [null, 0], [null, 0, 0.5, 44007, 1, 3], [null, 0, 2, "让你们见识一下冰碧帝皇蝎的威势！"], [null, 3], [null, 0, 2, 2, 44006, "冰冰，相信我，有你的帮助我的计划就有七成的把握"], [null, 5], [null, 0, 2, 2, 44006, "我选中的这个人类，我会让他像万年前的唐三一样晋阶为神"], [null, 4], [null, 0, 2, 2, 44006, "你忘了万年前星斗大森林的泰坦巨猿跟天青牛蟒吗？"], [null, 3], [null, 0, 2, 2, 40036, "一派胡言，连雪女大人都做不到这一点！"], [null, 2], [null, 0, 2, 2, 44006, "小冰冰，我知道你大限将至，我已经找到永生之法了"], [null, 1], [null, 0, 2, 2, 40036, "天梦，你的蚕蜕封印不了我多久"], [null, 0, 0.5, 44006, 1, 3], [null, 0], [null, 0, 0, 20013], [null, 0.7, 1, "E60401", 1, 47, 14], [null, 0.6, 1, 5], [null, 0, 0], [null, 0, 10, 1, 20170, "就凭你还有这个弱小的魂师？别做梦了！"], [null, 0, 10, 1, 20160, "我的本命蚕蜕对你的冰武魂可是具有强大的克制作用，现在你还是束手投降吧！"], [null, 0, 10, 1, 20170, "这是什么？天梦，你居然敢阴我！"], [null, 0.7, 1.5, "E53017", 1, 47, 14], [null, 0, 10, 1, 20170, "这么多年，你本事不见长，口气到是不小，今天就让我吸收你的能量来突破50万年的瓶颈吧！"], [null, 0, 10, 1, 20160, "小冰冰，我等这一天等了好久，我说过我一定要跟你永远在一起的！"], [null, 0, 10, 1, 20170, "天梦！你居然敢出现在极北之地，是不是活得不耐烦了？"], [null, 0.5, 0.5, 1, 20170, 47, 14], [null, 0.5, 0.5, 1, 20160, 41, 13], [null, 0, 1, 0], [null, 0, 0], [null, 0.6, 1, 5], [null, 0, 0], [null, 0, 5, "天梦哥，我感觉我已经达到20级瓶颈了，你快说我要怎么提升实力？"], [null, 0, 10, 1, 20160, "嗯，上次她应该受到什么影响导致神智不清，现在你知道实力的重要性了吧！"], [null, 0, 5, "天梦哥，我们上次遇到的火女应该就是她。"], [null, 0, 1, 0], [null, 0, 0], [null, 0, 0.1, 20012], [null, 0.3, 0.5, "E53034", 1, 35, 75], [null, 0.6, 1, 5], [null, 0, 0, 15], [null, 0, 0], [null, 0, 10, 1, 20140, "小……小桃姐……您怎么来了，我的烤鱼让给您吃，您手下留情，手下留情！"], [null, 0, 10, 1, 20150, "现在好像没有人排队了，是不是我可以吃烤鱼了？"], [null, 0.7, 1, "E53034", 1, 98, 60], [null, 0.4, 1.5], [null, 0, 1, 1, 20151, "谁敢排在我的前面？"], [null, 0, 10, 1, 20150, "是吗？"], [null, 0, 10, 1, 20010, "对不起，你看这么多人排队，今天的份已经卖完了！"], [null, 0, 2, 100, 60, 8], [null, 0, 10, 1, 20150, "今天的烤鱼，给我来一条！"], [null, 0, 1, 0], [null, 0, 0], [null, 0, 2, 2, 44005, "敢吵你天梦哥睡觉，看我天梦一指！"], [null, 3], [null, 0, 2, 2, 44005, "这么强烈的火武魂，难道是邪火凤凰？"], [null, 0, 0.5, 44005, 1, 3], [null, 2], [null, 0, 2, "救命啊……天梦哥！"], [null, 1], [null, 0, 2, 2, 40030, "好……热……好……热……"], [null, 0], [null, 0, 0.1, 20011], [null, 0.5, 1, "E53034", 1, 35, 75], [null, 0, 0, 15], [null, 0.6, 1, 5], [null, 0, 0], [null, 0, 2.5, 1, 20122, "好热……我要……焚尽一切……"], [null, 0.5, 1, "E66991", 1, 35, 75], [null, 0.2, 1.5], [null, 0, 2, 35, 75, 12], [null, 0, 0], [null, 0.5, 2, "嗯？谁在那！"], [null, 0.4, 1, 1, 1, 35, 75], [null, 0.4, 2], [null, 0, 1, 5], [null, 0, 0], [null, 0, 2, 2, 44004, "精神共享？就是这个机会，给我破！！"], [null, 3], [null, 0, 2, 2, 40027, "我永恒之御可不是你们可以轻易破开的"], [null, 2], [null, 0, 2, 2, 44004, "输给我的话，你可得送我一颗玄水丹"], [null, 1], [null, 0, 2, 2, 40027, "最强之盾对战最强之矛，让我全身都充满兴奋"], [null, 0, 0.5, 44004, 1, 2], [null, 0], [null, 0, 2, 2, 40024, "你们可以精神共享视野？这太不可思议了！"], [null, 2], [null, 0, 2, "嘿嘿，忘了告诉你我们有共享视野，你的动作我们早就捕捉到了！"], [null, 0, 2, 2, 40024, "小心我的定装轰击！"], [null, 1], [null, 0, 2, 2, 40024, "定装魂导器威力巨大，这次模拟对战我就用一成的威力吧"], [null, 0], [null, 0, 2, "兄弟们，让他们见识一下我们三人组的实力"], [null, 2], [null, 0, 2, 2, 40019, "哼，周老师分明就是偏心，也不知道看上你哪点了"], [null, 1], [null, 0, 2, 2, 40021, "我白虎公爵的二少还从没受到这种委屈呢"], [null, 0], [null, 0, 2, 2, 40018, "贝贝你少管闲事，有本事跟我上斗魂场赌战<img src='E61522/>"], [null, 4], [null, 0, 2, 2, 44003, "徐三石，你以大欺小害不害臊"], [null, 0, 0.5, 44003, 1, 2], [null, 3], [null, 0, 2, 2, 40018, "不过你以为我永恒之御的名头是交学费送的吗？<img src='E61519/>"], [null, 2], [null, 0, 2, 2, 40018, "你们是新生？实力不错啊。<img src='E61521/>"], [null, 1], [null, 0, 2, 2, 40018, "哼，敢惹我的女神不开心，你们胆子倒不小<img src='E61503/>"], [null, 0], [null, 0, 10, 1, 20081, "徐三石，我已经跟你说得很清楚了，我跟你绝对不可能。"], [null, 0, 10, 1, 20080, "江楠楠，你想吃烤鱼吗？喂！小子，这是一枚金魂币，你这几条烤鱼我全要了。"], [null, 0, 10, 1, 20081, "这么贵，我看你成本应该只要四五个银魂币吧……算了，我下次再来好了。"], [null, 0, 10, 1, 20010, "十个银魂币一条，不过今天我的烤鱼已经卖完了。"], [null, 0, 10, 1, 20081, "好香的烤鱼，请问你这烤鱼怎么卖的？"], [null, 0.5, 0.5, 1, 20081, 106, 54], [null, 0, 1, 1], [null, 0, 2, "嘻嘻，看来宿舍老大是我的了！"], [null, 2], [null, 0, 2, 2, 40015, "你穿上学院新生装备了吗？怎么变得这么强！<img src='E61506'/>"], [null, 1], [null, 0, 2, "嘿嘿，我这段时间进步也不小呢！<img src='E61522/>"], [null, 0, 2, 2, 40015, "这一次我可是要全力以赴了<img src='E61508'/>"], [null, 0], [null, 0, 2, 2, 44001, "吃我一记雷霆龙爪"], [null, 3], [null, 0, 2, "贝贝师兄，让我助你锁定目标"], [null, 2], [null, 0, 2, 2, 44001, "小心不要被它咬到，曼荼罗毒十分凶狠<img src='E61521'/>"], [null, 1], [null, 0, 2, 2, 44001, "千年曼荼罗蛇可不好对付，一定要小心<img src='E61508'/>"], [null, 0, 0.5, 44001, 1, 2], [null, 0], [null, 0, 0, 15], [null, 0, 1, 0], [null, 0, 0, 3], [null, 0, 0], [null, 0, 5, 1, 20060, "小雅，你才刚当上唐门门主没多久，就四处想招人，还是要看他自己的意思吧，嘘，他好像要醒了。"], [null, 0, 5, 1, 20050, "可惜这风狒狒年份不高，魂环品质肯定好不到哪去，对了，你说我们要不要把他收进唐门啊。"], [null, 0, 5, 1, 20060, "我看看，嗯，看样子是刚吸收了魂环昏睡过去了，我们守着他吧。"], [null, 0, 5, 1, 20050, "贝贝快来！这是不是就是周漪老师说的新生呀，这附近还有只风狒狒。"], [null, 0, 2, 51, 28, 6], [null, 0, 0.1, 3], [null, 0, 0.5, 0], [null, 0, 4, 0, "手握日月摘星辰，世间无我这般人！||<div fontcolor=#0b9bff>喂！你这臭老头，这精神海是我的地盘，你给我走开！！！</div>", 5, 26, 0], [null, 0, 2, 0], [null, 0, 3, 2, 44002, "终有一天，我会让你明白我的选择！"], [null, 0, 3, 2, 40009, "天梦，你居然愿意成为人类的魂环，简直是魂兽的耻辱！"], [null, 3], [null, 0, 3, 2, 44002, "我天梦虽然不能成神，但我也要成为神的一部分。"], [null, 0, 3, 2, 40009, "我要让你们付出代价！"], [null, 0, 0, 40009, "M40011"], [null, 0, 3, 2, 40009, "看我黑龙变身！"], [null, 2], [null, 0, 3, 2, 44002, "哼，要不是你们抽取我的魂力，星斗魂兽怎么可能有如今的实力？"], [null, 0, 3, 2, 40009, "<img src='E61519'/>该死，刚追踪这只肥虫耗费了九成的实力，居然连你们都收拾不了！"], [null, 1], [null, 0, 3, 2, 44002, "他只是一缕意识化身，不用担心！"], [null, 0, 0.5, 44002, 1, 2], [null, 0, 3, 2, 40009, "<img src='E61503'/>无知无畏的凡人，你居然敢插手本大人的事！"], [null, 0], [null, 0, 0, 15], [null, 0, 1, 0], [null, 0, 0, 3], [null, 0, 0], [null, 0, 5, 1, 20030, "就算你本尊亲至，我也不会束手就擒，何况你仅仅一个身外化身？"], [null, 0, 5, 1, 20040, "乖乖做本王的宠物，我保证不会有其他人会伤害到你！"], [null, 0, 5, 1, 20040, "肥虫，你倒是挺会跑的呀！"], [null, 0.5, 0.5, 1, 20040, 32, 33], [null, 0, 1, "E60413", 1, 32, 33], [null, 0.4, 1.5], [null, 0, 5, 1, 20030, "我天梦哥终于逃出来了！"], [null, 0, 1, 0], [null, 0, 0.1, 3], [null, 0, 0], [null, 0, 2, 36, 37, 6], [null, 0, 1, 0, "星斗大森林深处突然传来强烈的震动……", 5, 26, 0], [null, 0, 0.1, 0], [null, 0, 1, 1063], [null, 0], [null, 0, 2, 2, 40002, "这次算本姑娘输了，但是我一定会打败你的！<img src='E61506'/>"], [null, 2], [null, 0, 2, 2, 40002, "这是什么枪法，还真准！<img src='E61521'/>"], [null, 0, 1, 1061], [null, 1], [null, 0, 2, "嘿嘿，你以为会玩火我就怕了吗？<img src='E61522'/>"], [null, 0, 1, 1068], [null, 0], [null, 0, 2, 2, 40002, "这次算本姑娘输了，但是我一定会打败你的！<img src='E61506'/>"], [null, 2], [null, 0, 2, 2, 40002, "怎么可能，你居然会群攻魂技<img src='E61521'/>"], [null, 0, 1, 1061], [null, 1], [null, 0, 2, "嘿嘿，你以为你们人多我就怕了吗？<img src='E61522'/>"], [null, 0, 1, 1068], [null, 0], [null, 0, 2, 2, 40002, "这次算本姑娘输了，但是我一定会打败你的！<img src='E61506'/>"], [null, 2], [null, 0, 2, 2, 40002, "怎么可能，你居然会群攻魂技<img src='E61521'/>"], [null, 0, 1, 1061], [null, 1], [null, 0, 2, "嘿嘿，你以为你们人多我就怕了吗？<img src='E61522'/>"], [null, 0, 1, 1068], [null, 0], [null, 1, 1, 5], [null, 0, 0], [null, 0, 5, 1, 20020, "没想到今天又遇到一个更低的，真是笑死人了呢。"], [null, 0, 5, 1, 20020, "我们史莱克向来是只收天才怪物不收普通人的，我本以为霍雨浩已经是魂力最低的人了。"], [null, 0, 0], [null, 0, 1, 5], [null, 0, 1.5, 1064], [null, 1], [null, 0, 1.5, 2, 40001, "<img src='E61502'/>每位魂师都可以施展魂技进行战斗！"], [null, 0, 1.5, 1061], [null, 0], [null, 0, 0.5, 0], [null, 0, 3.5, 0, "自从<div fontcolor=#0b9bff>日月帝国</div>与<div fontcolor=#0b9bff>斗罗三国</div>停战已过了<div fontcolor=#0b9bff>七千年</div>||尽管成功保留下<div fontcolor=#0b9bff>斗罗大陆</div>的名号||但是厉兵秣马的日月帝国凭借<div fontcolor=#0b9bff>魂导器</div>再度崛起||新的<div fontcolor=#0b9bff>史莱克七怪</div>能否力挽狂澜……", 5, 23, 0], [null, 0, 1, 0]]}}